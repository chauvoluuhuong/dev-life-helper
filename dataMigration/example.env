# Example Environment Configuration for PostgreSQL Migration
# Copy this file to .env and modify the values as needed

# Source Database Configuration (where data is migrated FROM)
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5432
SOURCE_DB_USERNAME=postgres
SOURCE_DB_PASSWORD=postgres

# Target Database Configuration (where data is migrated TO)
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5433
TARGET_DB_USERNAME=postgres
TARGET_DB_PASSWORD=postgres
